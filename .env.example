# ==============================================================================
# SIGN Chapter SMC Swat - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Fill in your project URL and public Anon Key from your Supabase Dashboard:
#    Project Settings -> API -> Project URL & Project API Keys (anon / public)
#
# NOTE: DO NOT EXPOSE YOUR SERVICE ROLE KEY IN THIS FILE OR CLIENT CODE!
# ==============================================================================

# Public Supabase API credentials (safe for client-side use)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Application Base URL for OAuth / Email confirmation redirects
VITE_APP_URL=http://localhost:5173

# Resend API Key for automated certificate emails (Get free from https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
